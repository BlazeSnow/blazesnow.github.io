{
    "name": "blazesnow",
    "compatibility_date": "2026-10-01",
    "assets": {
        "directory": ".vitepress/dist/",
        "not_found_handling": "404-page"
    },
    "workers_dev": false,
    "preview_urls": false,
    "routes": [
        {
            "pattern": "www.blazesnow.com/*",
            "zone_name": "blazesnow.com"
        }
    ],
    "observability": {
        "logs": {
            "enabled": false,
            "invocation_logs": false
        },
        "traces": {
            "enabled": false
        }
    }
}